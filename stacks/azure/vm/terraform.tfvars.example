# Azure VM Configuration
# Copy this file to terraform.tfvars and customize

# Project and Environment
project_name = "quickvm"
environment  = "training"  # dev, training, or prod

# Region
location = "eastus"

# Resource Group Configuration (optional)
# Set use_existing_resource_group to true if you don't have permissions to create resource groups
use_existing_resource_group  = false
existing_resource_group_name = null  # Set this when use_existing_resource_group = true
# Example: existing_resource_group_name = "1-f02f2411-playground-sandbox"

# Operating System
os_distribution = "ubuntu"  # ubuntu or azure-linux

# Instance Sizing (leave null to use environment defaults)
# dev:      Standard_B1s,  30GB
# training: Standard_B2ms, 50GB
# prod:     Standard_D2s_v3, 100GB
vm_size        = null
os_disk_size_gb = null
os_disk_type   = "Standard_LRS"

# Security
allowed_ports = [22, 80, 8080]
allowed_cidrs = ["0.0.0.0/0"]  # Restrict to your IP: ["203.0.113.0/24"]

# SSH Access (REQUIRED)
# Generate key: ssh-keygen -t rsa -b 4096 -f ~/.ssh/id_rsa
# Get public key: cat ~/.ssh/id_rsa.pub
admin_username = "azureuser"
ssh_public_key = "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAACAQ... your_key_here"

# Static Public IP
enable_public_ip = true

# Auto-Shutdown (recommended for sandbox/training)
enable_auto_shutdown = true
auto_shutdown_hours  = 4
auto_shutdown_timezone = "UTC"

# Software Installation (installed by default)
install_docker  = true   # Set to false to skip Docker installation
install_jenkins = true   # Set to false to skip Jenkins installation (requires Docker)

# Optional: Managed identity for Azure resource access
# enable_managed_identity = true

# Optional: Email notifications for auto-shutdown
# auto_shutdown_notification_enabled = false

# Additional tags
tags = {
  Owner = "your-name"
  Team  = "engineering"
}
