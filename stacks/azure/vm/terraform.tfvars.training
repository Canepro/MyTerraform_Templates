# Training Environment Profile
# Usage: terraform apply -var-file=terraform.tfvars.training

project_name = "quickvm"
environment  = "training"
location     = "westus"  # Must match existing resource group location

# Resource Group Configuration
use_existing_resource_group    = true
existing_resource_group_name   = "1-f02f2411-playground-sandbox"

# OS
os_distribution = "ubuntu"

# Sizing (uses training profile defaults: Standard_B2ms, 50GB)
vm_size        = null
os_disk_size_gb = null

# Security
allowed_ports = [22, 80, 8080]
allowed_cidrs = ["0.0.0.0/0"]

# SSH - REPLACE WITH YOUR PUBLIC KEY
admin_username = "azureuser"
ssh_public_key = "ssh-rsa "

# Static IP
enable_public_ip = true

# Auto-shutdown after 4 hours
enable_auto_shutdown = true
auto_shutdown_hours  = 4
auto_shutdown_timezone = "UTC"

tags = {
  CostCenter = "training"
  Owner      = "training-team"
}

