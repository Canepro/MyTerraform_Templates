# AWS EC2 VM Configuration
# Copy this file to terraform.tfvars and customize

# Project and Environment
project_name = "quickvm"
environment  = "training"  # dev, training, or prod

# Region
region = "us-east-1"

# Operating System
os_distribution = "amazon-linux"  # amazon-linux or ubuntu
use_latest_ami  = true            # Automatically use latest AMI

# Instance Sizing (leave null to use environment defaults)
# dev:      t3.micro,  30GB
# training: t3.medium, 50GB
# prod:     t3.large,  100GB
instance_type    = null
root_volume_size = null
root_volume_type = "gp3"

# Networking (leave null to use default VPC)
vpc_id            = null
subnet_id         = null
availability_zone = null

# Security
allowed_ports = [22, 80, 8080]
allowed_cidrs = ["0.0.0.0/0"]  # Restrict to your IP: ["203.0.113.0/24"]

# SSH Access (REQUIRED)
# Create key pair: aws ec2 create-key-pair --key-name my-key --query 'KeyMaterial' --output text > ~/.ssh/my-key.pem
key_name = "my-aws-key"

# Static Public IP
enable_eip = true

# Auto-Shutdown (recommended for sandbox/training)
enable_auto_shutdown = true
auto_shutdown_hours  = 4

# Software Installation (installed by default)
install_docker  = true   # Set to false to skip Docker installation
install_jenkins = true   # Set to false to skip Jenkins installation (requires Docker)

# Optional: Custom user data
# user_data = <<-EOT
#   #!/bin/bash
#   echo "Additional setup commands"
# EOT

# Optional: IAM instance profile
# iam_instance_profile = "my-instance-profile"

# Optional: Advanced settings
enable_detailed_monitoring    = false
enable_termination_protection = false

# Additional tags
tags = {
  Owner = "your-name"
  Team  = "engineering"
}
