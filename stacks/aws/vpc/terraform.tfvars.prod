# ============================================
# Example: Production Environment
# ============================================
aws_region   = "us-east-1"
environment  = "prod"
project_name = "my-project"

# VPC Configuration with 3 AZs for High Availability
vpc_cidr           = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b", "us-east-1c"]

# Public Subnets (smaller /26 for production to save IP space)
public_subnet_cidrs = [
  "10.0.1.0/26",  # us-east-1a
  "10.0.1.64/26", # us-east-1b
  "10.0.1.128/26" # us-east-1c
]

# Private Subnets (larger /23 for more resources)
private_subnet_cidrs = [
  "10.0.10.0/23",  # us-east-1a
  "10.0.12.0/23",  # us-east-1b
  "10.0.14.0/23"   # us-east-1c
]

# NAT Gateway (one per AZ for high availability)
enable_nat_gateway = true
single_nat_gateway = false  # HA setup with NAT per AZ

# VPC Endpoints
enable_s3_endpoint = true

# VPC Flow Logs (longer retention for compliance)
enable_flow_logs         = true
flow_logs_retention_days = 30
flow_logs_traffic_type   = "ALL"

# Tags
tags = {
  Team        = "DevOps"
  CostCenter  = "Engineering"
  Application = "Infrastructure"
  Backup      = "Daily"
  Compliance  = "Required"
}

